{
  "version": 2,
  "note": "Sound words -> knob moves, served to Muse by the suggest_moves tool (fx/vocab.ts). Each move is applied with insert_device/set_param: op 'set' sets the value, 'add' adds (dB, %, Hz...) to the current value, 'mul' multiplies. A word can have one entry per source type (vocal, bass, drums, pad, guitar, bus, master; 'any' matches all); the most specific entry wins. aliases are other ways to say the word. note is one line for Muse: what the move does and what to listen for. Applied to a fresh device, every value stays inside the knob's agentRange; tests/fx.test.ts checks this and that every device/param is real.",
  "entries": [
    { "word": "bright", "aliases": ["brighter", "crisp", "sparkle", "shine"], "sourceTypes": ["vocal", "pad", "drums", "guitar"], "moves": [{ "device": "eq", "param": "hs_gain", "op": "add", "value": 3 }], "note": "high shelf lift; too much turns harsh or hissy" },
    { "word": "airy", "aliases": ["air", "breathy", "open top"], "sourceTypes": ["vocal", "pad"], "moves": [{ "device": "eq", "param": "hs_freq", "op": "set", "value": 12000 }, { "device": "eq", "param": "hs_gain", "op": "add", "value": 3 }], "note": "lift above 12 kHz only; lower shelves add harshness instead of air" },
    { "word": "dull", "aliases": ["darker", "less bright", "dark", "mellow"], "sourceTypes": ["any"], "moves": [{ "device": "eq", "param": "hs_gain", "op": "add", "value": -3 }], "note": "high shelf cut; takes the edge off" },
    { "word": "muddy", "aliases": ["mud", "murky", "cloudy", "boomy low mids"], "sourceTypes": ["vocal", "pad", "guitar"], "moves": [{ "device": "eq", "param": "hp_on", "op": "set", "value": true }, { "device": "eq", "param": "hp_freq", "op": "set", "value": 100 }, { "device": "eq", "param": "b1_freq", "op": "set", "value": 300 }, { "device": "eq", "param": "b1_gain", "op": "add", "value": -3 }], "note": "low cut plus a low-mid dip around 300 Hz" },
    { "word": "muddy", "aliases": ["mud", "murky", "cloudy", "woolly"], "sourceTypes": ["bass"], "moves": [{ "device": "eq", "param": "hp_on", "op": "set", "value": true }, { "device": "eq", "param": "hp_freq", "op": "set", "value": 30 }, { "device": "eq", "param": "b1_freq", "op": "set", "value": 250 }, { "device": "eq", "param": "b1_gain", "op": "add", "value": -4 }], "note": "a bass's mud is 200-300 Hz; keep the low cut at 30 Hz so the fundamental stays" },
    { "word": "boomy", "aliases": ["boom", "too much low end", "bloated"], "sourceTypes": ["any"], "moves": [{ "device": "eq", "param": "ls_freq", "op": "set", "value": 120 }, { "device": "eq", "param": "ls_gain", "op": "add", "value": -3 }], "note": "low shelf cut; check it still has weight on small speakers" },
    { "word": "boxy", "aliases": ["honky", "cardboard"], "sourceTypes": ["vocal", "drums", "guitar"], "moves": [{ "device": "eq", "param": "b2_freq", "op": "set", "value": 600 }, { "device": "eq", "param": "b2_gain", "op": "add", "value": -3 }], "note": "dip around 600 Hz" },
    { "word": "nasal", "aliases": ["nasally", "pinched"], "sourceTypes": ["vocal"], "moves": [{ "device": "eq", "param": "b2_freq", "op": "set", "value": 1000 }, { "device": "eq", "param": "b2_gain", "op": "add", "value": -3 }], "note": "dip around 1 kHz" },
    { "word": "warm", "aliases": ["warmer", "warmth", "rounder", "fuller"], "sourceTypes": ["vocal"], "moves": [{ "device": "eq", "param": "b1_freq", "op": "set", "value": 250 }, { "device": "eq", "param": "b1_gain", "op": "add", "value": 1.5 }, { "device": "eq", "param": "hs_gain", "op": "add", "value": -1.5 }, { "device": "sat", "param": "model", "op": "set", "value": "tape" }, { "device": "sat", "param": "drive", "op": "set", "value": 4 }], "note": "a little low-mid body, softer top, gentle tape; on a vocal warmth is mostly saturation, not bass" },
    { "word": "warm", "aliases": ["warmer", "warmth", "rounder", "fuller"], "sourceTypes": ["bass"], "moves": [{ "device": "eq", "param": "ls_freq", "op": "set", "value": 120 }, { "device": "eq", "param": "ls_gain", "op": "add", "value": 3 }, { "device": "eq", "param": "hs_gain", "op": "add", "value": -2 }, { "device": "sat", "param": "model", "op": "set", "value": "tape" }, { "device": "sat", "param": "drive", "op": "set", "value": 6 }], "note": "low shelf lift, softer top, tape harmonics so it stays audible on small speakers" },
    { "word": "warm", "aliases": ["warmer", "warmth", "rounder", "fuller"], "sourceTypes": ["any"], "moves": [{ "device": "eq", "param": "hs_gain", "op": "add", "value": -2 }, { "device": "sat", "param": "model", "op": "set", "value": "tape" }, { "device": "sat", "param": "drive", "op": "set", "value": 4 }], "note": "softer top and gentle tape" },
    { "word": "thin", "aliases": ["thinner", "less body", "small"], "sourceTypes": ["vocal", "guitar"], "moves": [{ "device": "eq", "param": "hp_on", "op": "set", "value": true }, { "device": "eq", "param": "hp_freq", "op": "set", "value": 150 }], "note": "makes it thinner (low cut at 150 Hz); if the user says it already sounds thin, use warm instead" },
    { "word": "harsh", "aliases": ["harshness", "piercing", "shrill", "edgy", "smooth it out", "ear-fatiguing"], "sourceTypes": ["vocal", "guitar", "pad"], "moves": [{ "device": "eq", "param": "b3_freq", "op": "set", "value": 3500 }, { "device": "eq", "param": "b3_q", "op": "set", "value": 1.5 }, { "device": "eq", "param": "b3_gain", "op": "add", "value": -3 }], "note": "harshness lives at 2-5 kHz; if it's only the S sounds, use sibilant (de-esser) instead" },
    { "word": "presence", "aliases": ["present", "clearer", "clarity", "intelligible", "forward"], "sourceTypes": ["vocal", "guitar"], "moves": [{ "device": "eq", "param": "b3_freq", "op": "set", "value": 3000 }, { "device": "eq", "param": "b3_gain", "op": "add", "value": 2.5 }], "note": "bell around 3 kHz" },
    { "word": "sibilant", "aliases": ["sibilance", "s sounds", "harsh s", "sharp s", "esses", "essy", "spitty", "lispy"], "sourceTypes": ["vocal"], "moves": [{ "device": "deess", "param": "freq", "op": "set", "value": 6500 }, { "device": "deess", "param": "thresh", "op": "add", "value": -6 }, { "device": "deess", "param": "range", "op": "set", "value": 6 }], "note": "de-esser on 6.5 kHz; lower the threshold until only the S sounds dip; too much sounds lispy" },
    { "word": "gritty", "aliases": ["grit", "dirty", "crunchy", "crunch", "distorted", "edge"], "sourceTypes": ["any"], "moves": [{ "device": "sat", "param": "model", "op": "set", "value": "transistor" }, { "device": "sat", "param": "drive", "op": "add", "value": 6 }], "note": "transistor saturation; auto gain keeps the level steady" },
    { "word": "fuzzy", "aliases": ["fuzz", "blown out"], "sourceTypes": ["any"], "moves": [{ "device": "sat", "param": "model", "op": "set", "value": "fuzz" }, { "device": "sat", "param": "drive", "op": "set", "value": 18 }], "note": "heavy fuzz" },
    { "word": "punchy", "aliases": ["punch", "punchier", "more impact", "hit harder", "snappy"], "sourceTypes": ["drums", "bass"], "moves": [{ "device": "comp", "param": "style", "op": "set", "value": "vca" }, { "device": "comp", "param": "attack", "op": "set", "value": 25 }, { "device": "comp", "param": "release", "op": "set", "value": 80 }, { "device": "comp", "param": "ratio", "op": "set", "value": 4 }, { "device": "comp", "param": "thresh", "op": "add", "value": -6 }], "note": "slow attack (25 ms) lets each hit's transient through before the compressor clamps the tail; a fast attack (under 5 ms) does the opposite" },
    { "word": "glue", "aliases": ["glued", "cohesive", "together", "gel"], "sourceTypes": ["drums", "bus"], "moves": [{ "device": "comp", "param": "style", "op": "set", "value": "vca" }, { "device": "comp", "param": "ratio", "op": "set", "value": 2 }, { "device": "comp", "param": "attack", "op": "set", "value": 10 }, { "device": "comp", "param": "release", "op": "set", "value": 200 }, { "device": "comp", "param": "thresh", "op": "add", "value": -3 }], "note": "gentle bus compression, 1-3 dB of gain reduction" },
    { "word": "even", "aliases": ["consistent", "level out", "controlled", "smoother dynamics"], "sourceTypes": ["vocal", "bass"], "moves": [{ "device": "comp", "param": "style", "op": "set", "value": "opto" }, { "device": "comp", "param": "thresh", "op": "add", "value": -6 }, { "device": "comp", "param": "auto_gain", "op": "set", "value": true }], "note": "opto compression evens out loud and quiet phrases" },
    { "word": "stand out", "aliases": ["stand out more", "cut through", "upfront", "on top", "pop out", "sit on top"], "sourceTypes": ["vocal"], "moves": [{ "device": "eq", "param": "hp_on", "op": "set", "value": true }, { "device": "eq", "param": "hp_freq", "op": "set", "value": 100 }, { "device": "eq", "param": "b2_freq", "op": "set", "value": 350 }, { "device": "eq", "param": "b2_gain", "op": "add", "value": -2 }, { "device": "eq", "param": "b3_freq", "op": "set", "value": 3000 }, { "device": "eq", "param": "b3_gain", "op": "add", "value": 2.5 }, { "device": "comp", "param": "thresh", "op": "add", "value": -4 }], "note": "clear the lows and low mids, lift presence, compress so it holds its place; turning the other tracks down a little also works" },
    { "word": "wide", "aliases": ["wider", "width", "stereo", "bigger stereo"], "sourceTypes": ["pad", "guitar", "vocal", "bus"], "moves": [{ "device": "utility", "param": "width", "op": "add", "value": 30 }, { "device": "utility", "param": "mono_below", "op": "set", "value": 150 }], "note": "stereo width with the lows kept mono; a mono source needs chorus or reverb to get wider" },
    { "word": "mono", "aliases": ["centered", "narrow", "narrower"], "sourceTypes": ["any"], "moves": [{ "device": "utility", "param": "width", "op": "set", "value": 0 }], "note": "folds to mono" },
    { "word": "spacious", "aliases": ["space", "roomy", "ambient", "bigger room", "more reverb", "distant"], "sourceTypes": ["vocal", "pad", "guitar", "any"], "moves": [{ "device": "reverb", "param": "decay", "op": "mul", "value": 1.4 }, { "device": "reverb", "param": "mix", "op": "add", "value": 8 }], "note": "longer, wetter reverb; for a vocal keep predelay around 20-40 ms so the words stay clear" },
    { "word": "dry", "aliases": ["drier", "less reverb", "close", "intimate"], "sourceTypes": ["any"], "moves": [{ "device": "reverb", "param": "mix", "op": "add", "value": -8 }], "note": "less reverb" },
    { "word": "slapback", "aliases": ["slap", "rockabilly echo"], "sourceTypes": ["vocal", "guitar"], "moves": [{ "device": "delay", "param": "sync", "op": "set", "value": false }, { "device": "delay", "param": "time_ms", "op": "set", "value": 110 }, { "device": "delay", "param": "feedback", "op": "set", "value": 5 }], "note": "single short echo" },
    { "word": "telephone", "aliases": ["phone", "radio", "walkie talkie", "lo-fi vocal", "megaphone"], "sourceTypes": ["vocal", "any"], "moves": [{ "device": "eq", "param": "hp_on", "op": "set", "value": true }, { "device": "eq", "param": "hp_freq", "op": "set", "value": 350 }, { "device": "eq", "param": "hp_slope", "op": "set", "value": 24 }, { "device": "eq", "param": "lp_on", "op": "set", "value": true }, { "device": "eq", "param": "lp_freq", "op": "set", "value": 4000 }, { "device": "sat", "param": "model", "op": "set", "value": "transistor" }, { "device": "sat", "param": "drive", "op": "set", "value": 8 }], "note": "a phone passes roughly 300-3400 Hz; band-limit with the EQ's low and high cuts, a little transistor crunch for the speaker" },
    { "word": "underwater", "aliases": ["muffled", "through a wall", "next room"], "sourceTypes": ["any"], "moves": [{ "device": "filter", "param": "type", "op": "set", "value": "lowpass" }, { "device": "filter", "param": "cutoff", "op": "set", "value": 400 }], "note": "steep low-pass" },
    { "word": "lo-fi", "aliases": ["lofi", "bitcrushed", "crunchy digital", "retro"], "sourceTypes": ["any"], "moves": [{ "device": "crush", "param": "bits", "op": "set", "value": 8 }, { "device": "crush", "param": "downsample", "op": "set", "value": 4 }], "note": "bit and sample-rate reduction" },
    { "word": "octave up", "aliases": ["higher octave", "chipmunk"], "sourceTypes": ["any"], "moves": [{ "device": "pitch", "param": "semis", "op": "set", "value": 12 }], "note": "pitch shift +12 semitones" },
    { "word": "louder", "aliases": ["more level", "hotter"], "sourceTypes": ["master"], "moves": [{ "device": "limiter", "param": "gain", "op": "add", "value": 3 }], "note": "limiter input gain on the master; on a single track use set_gain instead" }
  ]
}
