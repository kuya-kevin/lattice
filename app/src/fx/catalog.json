        { "id": "feedback", "label": "Feedback", "type": "float", "unit": "%", "min": 0, "max": 110, "default": 35, "curve": "lin", "step": 1, "agentRange": [0, 85], "nudge": 10, "target": "fb.gain", "words": ["trailing", "dub", "spacey"], "help": "Above 100 % the echoes grow until the loop saturation holds them" },
