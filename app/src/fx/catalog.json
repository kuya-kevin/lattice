        { "id": "thresh", "label": "Threshold", "type": "float", "unit": "dB", "min": -90, "max": 0, "default": -50, "curve": "db", "step": 0.1, "agentRange": [-80, -20], "nudge": 3, "target": "/gate/thresh", "words": ["noisy", "bleed", "choppy"] },
