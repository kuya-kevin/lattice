    {
      "id": "comp",
      "label": "Compressor",
      "category": "dynamics",
      "logicRef": "Compressor",
      "impl": { "kind": "faust", "module": "comp", "license": "MIT" },
      "meters": ["gr_db"],
      "words": ["punchy", "tight", "glue", "squash", "smooth", "even", "controlled", "pumping", "stand out"],
      "presetParam": "style",
      "presets": {
        "clean": { "attack": 10, "release": 120, "knee": 6, "detector": "peak" },
        "vca": { "attack": 3, "release": 80, "knee": 0, "detector": "peak" },
        "fet": { "attack": 0.3, "release": 50, "knee": 2, "detector": "peak" },
        "opto": { "attack": 20, "release": 600, "knee": 12, "detector": "rms" }
      },
      "params": [
        { "id": "style", "label": "Style", "type": "enum", "options": ["clean", "vca", "fet", "opto"], "default": "clean", "target": "preset", "help": "Sets attack, release, knee and detector to a character preset" },
        { "id": "thresh", "label": "Threshold", "type": "float", "unit": "dB", "min": -60, "max": 0, "default": -18, "curve": "db", "step": 0.1, "agentRange": [-40, 0], "nudge": 3, "target": "/comp/thresh", "words": ["squash", "controlled", "even"] },
        { "id": "ratio", "label": "Ratio", "type": "float", "unit": ":1", "min": 1, "max": 20, "default": 3, "curve": "log", "step": 0.1, "agentRange": [1, 10], "nudge": 0.25, "target": "/comp/ratio", "words": ["squash", "glue"] },
        { "id": "knee", "label": "Knee", "type": "float", "unit": "dB", "min": 0, "max": 24, "default": 6, "curve": "lin", "step": 0.1, "agentRange": [0, 18], "nudge": 3, "target": "/comp/knee", "words": ["smooth"] },
        { "id": "attack", "label": "Attack", "type": "float", "unit": "ms", "min": 0.1, "max": 200, "default": 10, "curve": "log", "step": 0.1, "agentRange": [0.3, 80], "nudge": 0.5, "target": "/comp/attack", "words": ["punchy", "tight"], "help": "Time constant (to 63%) of the gain smoother when gain reduction increases" },
        { "id": "release", "label": "Release", "type": "float", "unit": "ms", "min": 10, "max": 2000, "default": 120, "curve": "log", "step": 1, "agentRange": [20, 1000], "nudge": 0.5, "target": "/comp/release", "words": ["pumping"] },
        { "id": "auto_rel", "label": "Auto Release", "type": "bool", "default": false, "target": "/comp/auto_rel" },
        { "id": "makeup", "label": "Makeup", "type": "float", "unit": "dB", "min": -12, "max": 24, "default": 0, "curve": "db", "step": 0.1, "agentRange": [-6, 12], "nudge": 1, "target": "/comp/makeup" },
        { "id": "auto_gain", "label": "Auto Gain", "type": "bool", "default": false, "target": "/comp/auto_gain" },
        { "id": "sc_hpf", "label": "Sidechain HPF", "type": "float", "unit": "Hz", "min": 20, "max": 500, "default": 20, "curve": "log", "step": 1, "agentRange": [20, 250], "nudge": 0.5, "target": "/comp/sc_hpf", "help": "High-passes the detector so bass does not pump the gain" },
        { "id": "detector", "label": "Detector", "type": "enum", "options": ["peak", "rms"], "default": "peak", "target": "/comp/detector" },
        { "id": "mix", "label": "Mix", "type": "float", "unit": "%", "min": 0, "max": 100, "default": 100, "curve": "lin", "step": 1, "agentRange": [20, 100], "nudge": 10, "target": "/comp/mix", "words": ["parallel"] }
      ]
    },
    {
      "id": "deess",
      "label": "De-Esser",
      "category": "dynamics",
      "logicRef": "DeEsser 2",
      "impl": { "kind": "faust", "module": "deess", "license": "MIT" },
      "meters": ["gr_db"],
      "words": ["harsh s", "sibilant", "spitty", "sharp", "too much ess", "lisp"],
      "params": [
        { "id": "freq", "label": "Frequency", "type": "float", "unit": "Hz", "min": 2000, "max": 16000, "default": 6500, "curve": "log", "step": 10, "agentRange": [3500, 11000], "nudge": 0.25, "target": "/deess/freq" },
        { "id": "thresh", "label": "Threshold", "type": "float", "unit": "dB", "min": -60, "max": 0, "default": -24, "curve": "db", "step": 0.1, "agentRange": [-50, -6], "nudge": 3, "target": "/deess/thresh", "words": ["sibilant", "too much ess", "lisp"], "help": "Relative mode: band level minus full-band level. Absolute: band level in dBFS" },
        { "id": "range", "label": "Max Reduction", "type": "float", "unit": "dB", "min": 0, "max": 24, "default": 6, "curve": "lin", "step": 0.1, "agentRange": [2, 12], "nudge": 2, "target": "/deess/range" },
        { "id": "mode", "label": "Detection", "type": "enum", "options": ["relative", "absolute"], "default": "relative", "target": "/deess/mode" },
