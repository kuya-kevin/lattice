        { "id": "high_cut", "label": "High Cut (loop)", "type": "float", "unit": "Hz", "min": 500, "max": 20000, "default": 6000, "curve": "log", "step": 10, "agentRange": [1500, 20000], "nudge": 0.333, "target": "loopLp.frequency", "words": ["tape echo", "dub"] },
        { "id": "sat", "label": "Tape Saturation", "type": "float", "unit": "%", "min": 0, "max": 100, "default": 0, "curve": "lin", "step": 1, "agentRange": [0, 70], "nudge": 10, "target": "loopShaper.curve", "words": ["tape echo"] },
