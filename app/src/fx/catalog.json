        { "id": "attack", "label": "Attack", "type": "float", "unit": "ms", "min": 0.1, "max": 50, "default": 1, "curve": "log", "step": 0.1, "agentRange": [0.1, 20], "nudge": 0.5, "target": "/gate/attack" },
        { "id": "hold", "label": "Hold", "type": "float", "unit": "ms", "min": 0, "max": 500, "default": 30, "curve": "lin", "step": 1, "agentRange": [0, 300], "nudge": 20, "target": "/gate/hold" },
        { "id": "release", "label": "Release", "type": "float", "unit": "ms", "min": 5, "max": 2000, "default": 100, "curve": "log", "step": 1, "agentRange": [10, 800], "nudge": 0.5, "target": "/gate/release", "words": ["tighten tails"] },
        { "id": "key_hpf", "label": "Key Low Cut", "type": "float", "unit": "Hz", "min": 20, "max": 2000, "default": 20, "curve": "log", "step": 1, "agentRange": [20, 1000], "nudge": 0.5, "target": "/gate/key_hpf" },
        { "id": "key_lpf", "label": "Key High Cut", "type": "float", "unit": "Hz", "min": 1000, "max": 20000, "default": 20000, "curve": "log", "step": 10, "agentRange": [2000, 20000], "nudge": 0.5, "target": "/gate/key_lpf" }
      ]
    },
