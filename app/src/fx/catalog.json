{
  "$schema": "./catalog.schema.json",
  "version": 1,
  "devices": [
    {
      "id": "utility",
      "label": "Utility",
      "category": "utility",
      "logicRef": "Gain / Direction Mixer / Stereo Spread",
      "impl": { "kind": "native", "module": "utility", "license": "MIT" },
      "words": ["wider", "narrower", "mono", "centered", "louder", "quieter", "flip phase", "focus the low end"],
      "params": [
        { "id": "gain", "label": "Gain", "type": "float", "unit": "dB", "min": -48, "max": 24, "default": 0, "curve": "db", "step": 0.1, "agentRange": [-24, 12], "nudge": 2, "target": "gain.gain", "words": ["louder", "quieter"], "help": "Static gain after the stereo matrix" },
        { "id": "pan", "label": "Pan", "type": "float", "unit": "", "min": -1, "max": 1, "default": 0, "curve": "lin", "step": 0.01, "agentRange": [-1, 1], "nudge": 0.2, "target": "panner.pan", "help": "-1 = hard left, +1 = hard right (equal-power StereoPanner)" },
        { "id": "width", "label": "Width", "type": "float", "unit": "%", "min": 0, "max": 200, "default": 100, "curve": "lin", "step": 1, "agentRange": [0, 160], "nudge": 20, "target": "matrix.side", "words": ["wider", "narrower", "mono"], "help": "Side gain of an M/S matrix: 0 = mono, 100 = unchanged, 200 = side doubled" },
        { "id": "mono_below", "label": "Mono Below", "type": "float", "unit": "Hz", "min": 20, "max": 500, "default": 20, "curve": "log", "step": 1, "agentRange": [20, 250], "nudge": 0.333, "target": "xover.freq", "words": ["focus the low end"], "help": "Linkwitz-Riley crossover; everything below is summed to mono. 20 = off" },
        { "id": "phase_l", "label": "Invert L", "type": "bool", "default": false, "target": "matrix.signL", "words": ["flip phase"] },
        { "id": "phase_r", "label": "Invert R", "type": "bool", "default": false, "target": "matrix.signR", "words": ["flip phase"] },
        { "id": "swap", "label": "Swap L/R", "type": "bool", "default": false, "target": "matrix.swap" }
      ]
    },
    {
      "id": "eq",
      "label": "Channel EQ",
