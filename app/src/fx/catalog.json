        { "id": "shape", "label": "Filter", "type": "enum", "options": ["bandpass", "highshelf"], "default": "bandpass", "target": "/deess/shape" },
        { "id": "listen", "label": "Listen", "type": "bool", "default": false, "target": "/deess/listen" }
      ]
    },
    {
      "id": "gate",
      "label": "Noise Gate",
      "category": "dynamics",
      "logicRef": "Noise Gate",
      "impl": { "kind": "faust", "module": "gate", "license": "MIT" },
