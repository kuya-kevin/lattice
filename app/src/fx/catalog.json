        { "id": "hp_slope", "label": "Low Cut Slope", "type": "enum", "unit": "dB/oct", "options": [12, 24, 36, 48], "default": 24, "group": "low cut", "rebuild": true, "target": "hp.order" },
        { "id": "ls_freq", "label": "Low Shelf Freq", "type": "float", "unit": "Hz", "min": 20, "max": 1000, "default": 100, "curve": "log", "step": 1, "agentRange": [40, 500], "nudge": 0.333, "group": "low shelf", "target": "ls.frequency" },
        { "id": "ls_gain", "label": "Low Shelf Gain", "type": "float", "unit": "dB", "min": -24, "max": 24, "default": 0, "curve": "db", "step": 0.1, "agentRange": [-9, 9], "nudge": 2, "group": "low shelf", "target": "ls.gain", "words": ["warm", "boomy", "thin"] },
        { "id": "b1_freq", "label": "Bell 1 Freq", "type": "float", "unit": "Hz", "min": 20, "max": 20000, "default": 200, "curve": "log", "step": 1, "agentRange": [60, 600], "nudge": 0.333, "group": "bell 1", "target": "b1.frequency", "words": ["muddy", "warm"] },
        { "id": "b1_gain", "label": "Bell 1 Gain", "type": "float", "unit": "dB", "min": -24, "max": 24, "default": 0, "curve": "db", "step": 0.1, "agentRange": [-12, 9], "nudge": 2, "group": "bell 1", "target": "b1.gain" },
        { "id": "b1_q", "label": "Bell 1 Q", "type": "float", "unit": "", "min": 0.1, "max": 18, "default": 1, "curve": "log", "step": 0.01, "agentRange": [0.3, 6], "nudge": 0.5, "group": "bell 1", "target": "b1.Q" },
        { "id": "b2_freq", "label": "Bell 2 Freq", "type": "float", "unit": "Hz", "min": 20, "max": 20000, "default": 500, "curve": "log", "step": 1, "agentRange": [200, 1500], "nudge": 0.333, "group": "bell 2", "target": "b2.frequency", "words": ["boxy", "nasal"] },
        { "id": "b2_gain", "label": "Bell 2 Gain", "type": "float", "unit": "dB", "min": -24, "max": 24, "default": 0, "curve": "db", "step": 0.1, "agentRange": [-12, 9], "nudge": 2, "group": "bell 2", "target": "b2.gain" },
        { "id": "b2_q", "label": "Bell 2 Q", "type": "float", "unit": "", "min": 0.1, "max": 18, "default": 1, "curve": "log", "step": 0.01, "agentRange": [0.3, 6], "nudge": 0.5, "group": "bell 2", "target": "b2.Q" },
        { "id": "b3_freq", "label": "Bell 3 Freq", "type": "float", "unit": "Hz", "min": 20, "max": 20000, "default": 2500, "curve": "log", "step": 1, "agentRange": [1000, 6000], "nudge": 0.333, "group": "bell 3", "target": "b3.frequency", "words": ["presence", "harsh"] },
        { "id": "b3_gain", "label": "Bell 3 Gain", "type": "float", "unit": "dB", "min": -24, "max": 24, "default": 0, "curve": "db", "step": 0.1, "agentRange": [-12, 9], "nudge": 2, "group": "bell 3", "target": "b3.gain" },
        { "id": "b3_q", "label": "Bell 3 Q", "type": "float", "unit": "", "min": 0.1, "max": 18, "default": 1, "curve": "log", "step": 0.01, "agentRange": [0.3, 6], "nudge": 0.5, "group": "bell 3", "target": "b3.Q" },
        { "id": "b4_freq", "label": "Bell 4 Freq", "type": "float", "unit": "Hz", "min": 20, "max": 20000, "default": 6000, "curve": "log", "step": 1, "agentRange": [3000, 12000], "nudge": 0.333, "group": "bell 4", "target": "b4.frequency", "words": ["harsh", "sibilant"] },
        { "id": "b4_gain", "label": "Bell 4 Gain", "type": "float", "unit": "dB", "min": -24, "max": 24, "default": 0, "curve": "db", "step": 0.1, "agentRange": [-12, 9], "nudge": 2, "group": "bell 4", "target": "b4.gain" },
        { "id": "b4_q", "label": "Bell 4 Q", "type": "float", "unit": "", "min": 0.1, "max": 18, "default": 1, "curve": "log", "step": 0.01, "agentRange": [0.3, 6], "nudge": 0.5, "group": "bell 4", "target": "b4.Q" },
        { "id": "hs_freq", "label": "High Shelf Freq", "type": "float", "unit": "Hz", "min": 1000, "max": 20000, "default": 10000, "curve": "log", "step": 1, "agentRange": [3000, 16000], "nudge": 0.333, "group": "high shelf", "target": "hs.frequency" },
        { "id": "hs_gain", "label": "High Shelf Gain", "type": "float", "unit": "dB", "min": -24, "max": 24, "default": 0, "curve": "db", "step": 0.1, "agentRange": [-9, 9], "nudge": 2, "group": "high shelf", "target": "hs.gain", "words": ["bright", "airy", "dull"] },
        { "id": "lp_on", "label": "High Cut", "type": "bool", "default": false, "group": "high cut", "rebuild": true, "target": "lp.on", "words": ["dull", "dark", "harsh"] },
        { "id": "lp_freq", "label": "High Cut Freq", "type": "float", "unit": "Hz", "min": 1000, "max": 20000, "default": 18000, "curve": "log", "step": 1, "agentRange": [4000, 20000], "nudge": 0.333, "group": "high cut", "target": "lp.frequency", "help": "Butterworth low-pass corner (-3 dB)" },
