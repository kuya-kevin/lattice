{
  "name": "lattice-app",
  "version": "0.1.0",
  "private": true,
  "description": "Lattice: a mini-DAW where Muse is your sound designer and session engineer",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build": "vite build && node scripts/build-electron.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "record-fixtures": "tsx scripts/record-fixtures.ts",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@dnd-kit/abstract": "^0.5.1",
    "@dnd-kit/dom": "^0.5.1",
    "@dnd-kit/react": "^0.5.1",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@huggingface/transformers": "4.3.1",
    "@waveform-playlist/browser": "^16.0.0",
    "@waveform-playlist/core": "^12.6.1",
    "@waveform-playlist/playout": "^12.5.4",
    "@waveform-playlist/recording": "^13.0.5",
    "@waveform-playlist/ui-components": "^14.0.0",
    "dotenv": "^18.0.9",
    "openai": "^7.45.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "styled-components": "^6.6.0",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "esbuild": "^0.28.2",
    "patch-package": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
