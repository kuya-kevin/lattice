{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit *)",
      "Bash(git rebase *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git worktree *)",
      "Bash(git merge --ff-only *)",
      "Bash(.githooks/scan-leaks.sh*)",
      "Bash(npx vitest run:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(npx playwright test:*)",
      "Bash(npm run build:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm test:*)"
    ],
    "ask": [
      "Bash(LATTICE_ALLOW_MAIN=1 *)",
      "Bash(git worktree remove *--force*)",
      "Bash(git worktree remove * -f*)",
      "Bash(git branch -D *)",
      "Bash(git reset --hard*)"
    ],
    "deny": [
      "Bash(git commit *--no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n *)",
      "Bash(git * core.hooksPath*)",
      "Bash(git push:*)",
      "Bash(npm run record-fixtures:*)"
    ]
  }
}
